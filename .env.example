# ── Server ────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/restaurant
PORT=5000

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
QR_JWT_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# Seed user passwords (used only by seed.js)
SEED_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
SEED_CHEF_PASSWORD=REPLACE_WITH_CHEF_PASSWORD
SEED_STAFF_PASSWORD=REPLACE_WITH_STAFF_PASSWORD

# ── Client ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000
